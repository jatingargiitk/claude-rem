{
  "description": "coding-brain hooks: debounced harvest on Stop, brain injection on UserPromptSubmit",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/harvest-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/recall-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
